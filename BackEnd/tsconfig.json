{
  "compilerOptions": {
    "module": "Node16",           // JS module code generation
    "target": "ES2022",
    "moduleResolution": "Node16", // How TS resolves imports
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "isolatedModules": true
  },
  "exclude": ["node_modules"]
}
